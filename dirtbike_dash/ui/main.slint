// ─────────────────────────────────────────────────────────────────────────────
// Dirtbike dash UI.
//
// The Rust side (see src/main.rs `run_ui`) owns one `in property <DashData> data`
// and one `in property <[string]> bms-errors`, and pushes fresh values into them
// ~30x/sec by reading the shared `backend::Backend` snapshot. Nothing in this file
// talks to CAN/GPS directly — it only renders whatever is in `data`.
//
// Menus / FSM: `MainWindow` holds `property <Menu> menu` and swaps which screen is
// mounted. The FocusScope maps keys to transitions. Each menu key is a toggle:
// press it to enter that menu, press the same key again to return to `main`.
//   q  quit        d  debug        f  faults
//   t  temps       p  powertrain   g  gps
// Rust does not know or care which menu is active — it always fills the same `data`.
// Add a menu: extend the `Menu` enum, add a `<Name>Menu` component, mount it with an
// `if menu == Menu.<name>` block, and add a key case in `nav(...)`.
//
// Easter egg: mashing all five menu keys (d f t p g) inside a 700 ms window opens
// the hidden `game` menu. `nav()` accumulates a bitmask in `chord`; `chord-timer`
// clears it once the window lapses. Any menu key then leaves the game.
//
// To surface a new value: add a field to `DashData` here, then set it in
// `run_ui`'s timer closure (Slint generates the matching Rust struct + setter).
// ─────────────────────────────────────────────────────────────────────────────

// Which screen is mounted. Boot state is `main`. `game` is the hidden chord menu.
export enum Menu {
    main,
    debug,
    fault,
    temp,
    powertrain,
    gps,
    game,
}

// Snapshot of everything the dash renders. Mirrors a subset of backend::Backend.
// Numeric fields are f32 (Slint `float`); anything needing precision or an
// Option (lat/lon, heading) is pre-formatted to a string on the Rust side.
export struct DashData {
    speed-mph: float,        // speed from motor RPM
    speed-gps: float,        // speed from GPS
    soc: float,              // pack state of charge, %
    pack-voltage: float,     // V
    pack-current: float,     // A
    aux-voltage: float,      // V
    aux-percent: float,      // %
    motor-temp: float,       // C
    mc-temp: float,          // C
    bms-temp: float,         // C
    high-cell-temp: float,   // C
    low-cell-temp: float,    // C
    motor-rpm: float,
    throttle: float,         // %  (pack current / 175 A)
    status: string,          // OFF / Idle / Precharge / Ready / Active / FAULT
    motor-on: bool,
    mc-fault: bool,
    bms-fault: bool,
    bms-warning: bool,
    bms-error: bool,
    bms-error-codes: string, // raw code bitfield, pre-formatted "0x00ABCD"
    gps-pos: string,         // "lat, lon" pre-formatted
    altitude-m: float,
    heading: string,         // "123.4" or "---"
    gps-fix: bool,
    gps-fix-mode: int,       // 0 = none, 2 = 2D, 3 = 3D
    gps-time-s: float,       // gpsd timestamp, epoch seconds
    time-active: float,      // seconds since boot
}

// number formatting helpers (Slint has no printf-style formatting)
export global Fmt {
    pure public function n0(v: float) -> string {
        return "\{Math.round(v)}";
    }
    pure public function n1(v: float) -> string {
        return "\{Math.round(v * 10) / 10}";
    }
}

// one "label : value" line for the debug list
component Kv inherits HorizontalLayout {
    in property <string> k;
    in property <string> v;
    in property <bool> alarm: false;

    height: 24px;
    spacing: 6px;
    Text {
        text: root.k;
        color: #8a8a8a;
        font-size: 13px;
        vertical-alignment: center;
        width: 130px;
    }
    Text {
        text: root.v;
        color: root.alarm ? #ff6b6b : #f2f2f2;
        font-size: 13px;
        font-weight: 600;
        vertical-alignment: center;
    }
}

// labelled readout tile: caption on top, big value + unit below
component Tile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> unit;
    in property <bool> warn: false;
    in property <bool> alarm: false;

    background: root.alarm ? #3a0f0f : (root.warn ? #3a300f : #141414);
    border-radius: 6px;
    border-width: 1px;
    border-color: root.alarm ? #ff4d4d : (root.warn ? #ffcc33 : #262626);

    VerticalLayout {
        padding: 10px;
        spacing: 3px;
        Text {
            text: root.label;
            color: #8a8a8a;
            font-size: 12px;
        }
        HorizontalLayout {
            alignment: start;
            spacing: 4px;
            Text {
                text: root.value;
                color: root.alarm ? #ff6b6b : (root.warn ? #ffd766 : #f2f2f2);
                font-size: 24px;
                font-weight: 700;
            }
            Text {
                text: root.unit;
                color: #6a6a6a;
                font-size: 12px;
                vertical-alignment: bottom;
            }
        }
    }
}

// large green/amber/red status box for a single fault or warning line
component FaultBox inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> is-warning: false;   // amber (not red) when active

    border-radius: 8px;
    border-width: 2px;
    background: !root.active ? #102410
        : (root.is-warning ? #3a2e0a : #3a0f0f);
    border-color: !root.active ? #1f7a34
        : (root.is-warning ? #ffcc33 : #ff3b3b);

    VerticalLayout {
        alignment: center;
        spacing: 4px;
        Text {
            text: root.label;
            horizontal-alignment: center;
            color: #d8d8d8;
            font-size: 15px;
            font-weight: 700;
        }
        Text {
            text: !root.active ? "OK" : (root.is-warning ? "WARNING" : "FAULT");
            horizontal-alignment: center;
            color: !root.active ? #35c759 : (root.is-warning ? #ffcc33 : #ff5b5b);
            font-size: 20px;
            font-weight: 800;
        }
    }
}

// small pill for one active BMS fault code
component Chip inherits Rectangle {
    in property <string> text;
    height: 22px;
    background: #2a0f0f;
    border-radius: 4px;
    border-width: 1px;
    border-color: #ff4d4d;
    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        Text {
            text: root.text;
            color: #ffb3b3;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}

// ── main-menu gauges ─────────────────────────────────────────────────────────

// throttle: ")"-shaped arc band that fills bottom → top with a dark → light blue
// gradient. Outline is a white border with a thin black separator inside it.
// Geometry is drawn in a fixed 116 x 400 viewbox (band between two arcs centred
// at (-260, 200), r = 310..360, ±32°); keep the element at that aspect (0.29).
component ThrottleArc inherits Rectangle {
    in property <float> value;   // 0..1

    property <string> shape:
        "M 45.3 390.8 A 360 360 0 0 0 45.3 9.2 L 2.9 35.7 A 310 310 0 0 1 2.9 364.3 Z";
    // vertical extent of the shape in viewbox units, used to map value → fill line
    property <float> top-v: 9.2;
    property <float> bot-v: 390.8;
    property <float> fill-v: root.bot-v - (root.bot-v - root.top-v) * clamp(root.value, 0, 1);

    // Slint fits a Path into (size - stroke-width), so each stroked layer is grown
    // by its stroke width to keep every layer on exactly the same geometry.

    // white outer border: 12px stroke centred on the edge → 6px shows outside
    Path {
        x: -6px; y: -6px;
        width: root.width + 12px; height: root.height + 12px;
        viewbox-x: -6; viewbox-y: 0; viewbox-width: 116; viewbox-height: 400;
        commands: root.shape;
        stroke: #ffffff;
        stroke-width: 12px;
    }

    // black interior + separator: 6px stroke → covers the inner 3px of the
    // white border, leaving 3px white outside 3px black
    Path {
        x: -3px; y: -3px;
        width: root.width + 6px; height: root.height + 6px;
        viewbox-x: -6; viewbox-y: 0; viewbox-width: 116; viewbox-height: 400;
        commands: root.shape;
        fill: #000000;
        stroke: #000000;
        stroke-width: 6px;
    }

    // gradient fill, clipped to the bottom `value` fraction of the shape
    Rectangle {
        y: root.height * root.fill-v / 400;
        height: root.height - self.y;
        clip: true;
        Path {
            y: -parent.y;
            width: root.width; height: root.height;
            viewbox-x: -6; viewbox-y: 0; viewbox-width: 116; viewbox-height: 400;
            commands: root.shape;
            fill: @linear-gradient(0deg, #0b2a7a 0%, #1f5fd6 50%, #8fd3ff 100%);
        }
    }
}

// battery: white case + terminal nub, black separator, SOC bar filling bottom → top.
// bar is green, yellow at ≤ 25 %, red at ≤ 10 %.
component Battery inherits Rectangle {
    in property <float> soc;     // 0..100

    property <length> nub-h: root.height * 0.05;

    Rectangle {
        x: (root.width - self.width) / 2;
        y: 0;
        width: root.width * 0.4;
        height: root.nub-h + 4px;   // tucks under the case's rounded top
        border-radius: 3px;
        background: #ffffff;
    }

    Rectangle {
        y: root.nub-h;
        height: root.height - root.nub-h;
        border-radius: 10px;
        background: #ffffff;

        Rectangle {
            x: 6px; y: 6px;
            width: parent.width - 12px;
            height: parent.height - 12px;
            border-radius: 6px;
            background: #000000;

            Rectangle {
                x: 5px; y: 5px;
                width: parent.width - 10px;
                height: parent.height - 10px;
                clip: true;

                Rectangle {
                    height: parent.height * clamp(root.soc, 0, 100) / 100;
                    y: parent.height - self.height;
                    border-radius: 3px;
                    background: root.soc <= 10 ? #ff3b3b
                        : (root.soc <= 25 ? #ffcc33 : #35c759);
                }
            }
        }
    }
}

// speedometer: 0..200 mph over a 270° sweep (gap at the bottom). Outer bezel,
// a speed bar over a faint track, ticks every 5 mph (labels every 20), a tapered
// needle, and the digital speed in the bottom gap. All white — depth comes from
// white at different opacities. Draws in a square of side min(width, height).
component Speedo inherits Rectangle {
    in property <float> mph;

    // all geometry in px (viewbox == element size)
    property <float> w: root.width / 1px;
    property <float> h: root.height / 1px;
    property <float> s: min(root.w, root.h);
    property <float> cx: root.w / 2;
    property <float> cy: root.h / 2;
    property <float> r: root.s * 0.47;              // bezel radius
    property <float> frac: clamp(root.mph / 200, 0, 1);
    property <float> band-r: root.r - root.s * 0.035;
    property <float> band-w: root.s * 0.04;
    property <float> tick-r: root.r - root.s * 0.075;  // outer end of the ticks
    property <float> label-r: root.r - root.s * 0.17;

    // dial angle (deg, math convention) for a 0..1 fraction: 225° → -45°
    pure function ang(f: float) -> float { return 225 - 270 * f; }
    pure function px(rad: float, a: float) -> float { return root.cx + rad * Math.cos(a * 1deg); }
    pure function py(rad: float, a: float) -> float { return root.cy - rad * Math.sin(a * 1deg); }
    // Slint fits a Path into (size - stroke-width); grow each stroked Path by its
    // stroke width (see `sw`) so the viewbox maps 1:1 onto this element.
    // clockwise arc from fraction 0 to fraction f at radius rad
    pure function arc(rad: float, f: float) -> string {
        return "M \{root.px(rad, root.ang(0))} \{root.py(rad, root.ang(0))} "
            + "A \{rad} \{rad} 0 \{f * 270 > 180 ? 1 : 0} 1 "
            + "\{root.px(rad, root.ang(f))} \{root.py(rad, root.ang(f))}";
    }

    // bezel
    Path {
        property <length> sw: 5px;
        x: -self.sw / 2; y: -self.sw / 2;
        width: root.width + self.sw; height: root.height + self.sw;
        viewbox-width: root.w; viewbox-height: root.h;
        commands: root.arc(root.r, 1);
        stroke: #ffffff;
        stroke-width: self.sw;
        stroke-line-cap: round;
    }

    // faint full-range track behind the speed bar
    Path {
        property <length> sw: root.band-w * 1px;
        x: -self.sw / 2; y: -self.sw / 2;
        width: root.width + self.sw; height: root.height + self.sw;
        viewbox-width: root.w; viewbox-height: root.h;
        commands: root.arc(root.band-r, 1);
        stroke: #ffffff1f;
        stroke-width: self.sw;
        stroke-line-cap: round;
    }

    // speed bar matching the needle
    if root.frac > 0.002: Path {
        property <length> sw: root.band-w * 1px;
        x: -self.sw / 2; y: -self.sw / 2;
        width: root.width + self.sw; height: root.height + self.sw;
        viewbox-width: root.w; viewbox-height: root.h;
        commands: root.arc(root.band-r, root.frac);
        stroke: #ffffff;
        stroke-width: self.sw;
        stroke-line-cap: round;
    }

    // ticks every 5 mph: major (20), medium (10), minor (5)
    for i in 41: Path {
        property <bool> major: Math.mod(i, 4) == 0;
        property <bool> medium: Math.mod(i, 2) == 0;
        property <float> a: root.ang(i / 40);
        property <float> r1: root.tick-r
            - root.s * (self.major ? 0.05 : (self.medium ? 0.032 : 0.018));
        property <length> sw: self.major ? 4px : (self.medium ? 2.5px : 1.5px);
        x: -self.sw / 2; y: -self.sw / 2;
        width: root.width + self.sw; height: root.height + self.sw;
        viewbox-width: root.w; viewbox-height: root.h;
        commands: "M \{root.px(root.tick-r, self.a)} \{root.py(root.tick-r, self.a)} "
            + "L \{root.px(self.r1, self.a)} \{root.py(self.r1, self.a)}";
        stroke: self.medium ? #ffffff : #ffffff99;
        stroke-width: self.sw;
        stroke-line-cap: round;
    }

    // labels 0, 20, ... 200
    for i in 11: Text {
        property <float> a: root.ang(i / 10);
        width: root.s * 0.12 * 1px;
        height: root.s * 0.06 * 1px;
        x: root.px(root.label-r, self.a) * 1px - self.width / 2;
        y: root.py(root.label-r, self.a) * 1px - self.height / 2;
        text: "\{i * 20}";
        color: #ffffff;
        font-size: root.s * 0.045 * 1px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // tapered needle: kite from a short tail through the hub to a sharp tip
    Path {
        property <float> a: root.ang(root.frac);
        property <float> tip: root.tick-r - root.s * 0.01;
        property <float> tail: root.s * 0.06;
        property <float> half: root.s * 0.016;     // half-width at the hub
        width: 100%; height: 100%;
        viewbox-width: root.w; viewbox-height: root.h;
        commands: "M \{root.px(self.tip, self.a)} \{root.py(self.tip, self.a)} "
            + "L \{root.px(self.half, self.a + 90)} \{root.py(self.half, self.a + 90)} "
            + "L \{root.px(self.tail, self.a + 180)} \{root.py(self.tail, self.a + 180)} "
            + "L \{root.px(self.half, self.a - 90)} \{root.py(self.half, self.a - 90)} Z";
        fill: #ffffff;
    }

    // hub: white cap with a black centre
    Rectangle {
        width: root.s * 0.065 * 1px;
        height: self.width;
        x: root.cx * 1px - self.width / 2;
        y: root.cy * 1px - self.height / 2;
        border-radius: self.width / 2;
        background: #ffffff;
        Rectangle {
            width: parent.width * 0.4;
            height: self.width;
            border-radius: self.width / 2;
            background: #000000;
        }
    }

    // digital speed + units in the bottom gap
    Text {
        width: root.s * 0.5 * 1px;
        height: root.s * 0.17 * 1px;
        x: root.cx * 1px - self.width / 2;
        y: (root.cy + root.r * 0.48) * 1px;
        text: Fmt.n0(root.mph);
        color: #ffffff;
        font-size: root.s * 0.16 * 1px;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Rectangle {
        width: root.s * 0.16 * 1px;
        height: 2px;
        x: root.cx * 1px - self.width / 2;
        y: (root.cy + root.r * 0.48 + root.s * 0.175) * 1px;
        background: #ffffff66;
    }
    Text {
        width: root.s * 0.3 * 1px;
        height: root.s * 0.06 * 1px;
        x: root.cx * 1px - self.width / 2;
        y: (root.cy + root.r * 0.48 + root.s * 0.185) * 1px;
        text: "MPH";
        color: #ffffff;
        font-size: root.s * 0.042 * 1px;
        font-weight: 700;
        letter-spacing: root.s * 0.008 * 1px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ── main menu: what the rider sees while riding ───────────────────────────────
// battery SOC (left) · speedometer (center) · throttle arc (right).
// The whole screen edge is an alert border: hidden normally, yellow on a BMS
// warning, red on any fault (faults win). Full telemetry lives in the debug menu.
component MainMenu inherits Rectangle {
    in property <DashData> data;
    background: #000000;

    // throttle fill: backend's `throttle` % (pack current / 175 A) as a 0..1 fraction
    property <float> throttle-frac: clamp(root.data.throttle / 100, 0, 1);
    property <bool> fault: root.data.mc-fault || root.data.bms-fault
        || root.data.bms-error || root.data.status == "FAULT";
    property <bool> warning: root.data.bms-warning;

    // alert border thickness, and the clear gap kept between it and the gauges
    property <length> alert-w: 8px;
    property <length> margin: 48px;
    property <length> dial: min(root.height - 2 * root.margin, root.width * 0.55);

    speedo := Speedo {
        width: root.dial;
        height: root.dial;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        mph: root.data.speed-mph;
    }

    Battery {
        height: root.height * 0.55;
        width: self.height * 0.36;
        x: root.margin + (speedo.x - root.margin - self.width) / 2;
        y: (root.height - self.height) / 2;
        soc: root.data.soc;
    }

    ThrottleArc {
        height: root.height - 2 * root.margin;
        width: self.height * 0.29;
        x: root.width - root.margin - self.width;
        y: root.margin;
        value: root.throttle-frac;
    }

    // alert border around the whole screen
    Rectangle {
        visible: root.fault || root.warning;
        background: transparent;
        border-width: root.alert-w;
        border-color: root.fault ? #ff3b3b : #ffcc33;
    }
}

// ── debug menu: every field of the DashData table, plainly ────────────────────
component DebugMenu inherits Rectangle {
    in property <DashData> data;
    in property <[string]> bms-errors;
    background: #0d0d0d;

    VerticalLayout {
        padding: 14px;
        spacing: 8px;

        Text {
            text: "DEBUG   ·   \{root.data.status}   ·   t+\{Fmt.n1(root.data.time-active)} s";
            color: #d0d0d0;
            font-size: 15px;
            font-weight: 700;
        }

        HorizontalLayout {
            spacing: 24px;

            VerticalLayout {
                spacing: 2px;
                alignment: start;
                Kv { k: "Speed (motor)"; v: "\{Fmt.n1(root.data.speed-mph)} mph"; }
                Kv { k: "Speed (GPS)"; v: "\{Fmt.n1(root.data.speed-gps)} mph"; }
                Kv { k: "Motor RPM"; v: Fmt.n0(root.data.motor-rpm); }
                Kv { k: "Throttle"; v: "\{Fmt.n0(root.data.throttle)} %"; }
                Kv { k: "Pack SOC"; v: "\{Fmt.n1(root.data.soc)} %"; }
                Kv { k: "Pack voltage"; v: "\{Fmt.n1(root.data.pack-voltage)} V"; }
                Kv { k: "Pack current"; v: "\{Fmt.n1(root.data.pack-current)} A"; }
                Kv {
                    k: "Aux voltage";
                    v: "\{Fmt.n1(root.data.aux-voltage)} V";
                    alarm: root.data.aux-voltage < 12;
                }
                Kv { k: "Aux percent"; v: "\{Fmt.n0(root.data.aux-percent)} %"; }
                Kv {
                    k: "Motor temp";
                    v: "\{Fmt.n1(root.data.motor-temp)} °C";
                    alarm: root.data.motor-temp > 110;
                }
                Kv {
                    k: "Controller temp";
                    v: "\{Fmt.n1(root.data.mc-temp)} °C";
                    alarm: root.data.mc-temp > 85;
                }
                Kv {
                    k: "BMS temp";
                    v: "\{Fmt.n1(root.data.bms-temp)} °C";
                    alarm: root.data.bms-temp > 55;
                }
                Kv { k: "High cell temp"; v: "\{Fmt.n1(root.data.high-cell-temp)} °C"; }
                Kv { k: "Low cell temp"; v: "\{Fmt.n1(root.data.low-cell-temp)} °C"; }
            }

            VerticalLayout {
                spacing: 2px;
                alignment: start;
                Kv { k: "Status"; v: root.data.status; }
                Kv { k: "Motor on"; v: root.data.motor-on ? "yes" : "no"; }
                Kv { k: "MC fault"; v: root.data.mc-fault ? "YES" : "no"; alarm: root.data.mc-fault; }
                Kv { k: "BMS fault"; v: root.data.bms-fault ? "YES" : "no"; alarm: root.data.bms-fault; }
                Kv {
                    k: "BMS warning";
                    v: root.data.bms-warning ? "YES" : "no";
                    alarm: root.data.bms-warning;
                }
                Kv { k: "BMS error"; v: root.data.bms-error ? "YES" : "no"; alarm: root.data.bms-error; }
                Kv { k: "BMS err codes"; v: root.data.bms-error-codes; }
                Kv { k: "GPS pos"; v: root.data.gps-pos; }
                Kv { k: "Altitude"; v: "\{Fmt.n1(root.data.altitude-m)} m"; }
                Kv { k: "Heading"; v: "\{root.data.heading}°"; }
                Kv { k: "GPS fix"; v: root.data.gps-fix ? "valid" : "none"; alarm: !root.data.gps-fix; }
                Kv { k: "GPS fix mode"; v: "\{root.data.gps-fix-mode}"; }
                Kv { k: "GPS time"; v: "\{Fmt.n1(root.data.gps-time-s)} s"; }
                Kv { k: "Time active"; v: "\{Fmt.n1(root.data.time-active)} s"; }
            }
        }

        // rolling BMS fault-code list (same source as the terminal debug view)
        Rectangle {
            vertical-stretch: 1;
            background: root.bms-errors.length > 0 ? #2a0f0f : #141414;
            border-radius: 6px;
            border-width: 1px;
            border-color: root.bms-errors.length > 0 ? #ff4d4d : #262626;
            VerticalLayout {
                padding: 8px;
                spacing: 2px;
                alignment: start;
                Text {
                    text: root.bms-errors.length > 0 ? "BMS FAULT CODES" : "BMS OK";
                    color: root.bms-errors.length > 0 ? #ff6b6b : #35c759;
                    font-size: 11px;
                    font-weight: 700;
                }
                for msg in root.bms-errors: Text {
                    text: "⚠ " + msg;
                    color: #ffb3b3;
                    font-size: 12px;
                }
            }
        }
    }
}

// ── fault menu (key f): big status boxes + BMS fault-code terminal ────────────
component FaultMenu inherits Rectangle {
    in property <DashData> data;
    in property <[string]> bms-errors;
    background: #0d0d0d;

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        Text {
            text: "FAULTS & WARNINGS   ·   \{root.data.status}";
            color: #d0d0d0;
            font-size: 15px;
            font-weight: 700;
        }

        // big colored boxes for the main.rs fault / warning flags
        GridLayout {
            spacing: 10px;
            Row {
                FaultBox { label: "MC FAULT"; active: root.data.mc-fault; }
                FaultBox { label: "BMS FAULT"; active: root.data.bms-fault; }
            }
            Row {
                FaultBox { label: "BMS ERROR"; active: root.data.bms-error; }
                FaultBox { label: "BMS WARNING"; active: root.data.bms-warning; is-warning: true; }
            }
        }

        // small boxes + terminal for the decoded BMS fault codes
        Rectangle {
            vertical-stretch: 1;
            background: #0a0a0a;
            border-radius: 6px;
            border-width: 1px;
            border-color: root.bms-errors.length > 0 ? #ff4d4d : #262626;

            VerticalLayout {
                padding: 8px;
                spacing: 6px;

                Text {
                    text: "BMS FAULT CODES   \{root.data.bms-error-codes}   ·   \{root.bms-errors.length} active";
                    color: root.bms-errors.length > 0 ? #ff6b6b : #35c759;
                    font-size: 12px;
                    font-weight: 700;
                }

                // small boxes (chips), horizontally scrollable
                Flickable {
                    height: 24px;
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for msg in root.bms-errors: Chip { text: msg; }
                    }
                }

                // terminal
                Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        spacing: 2px;
                        if root.bms-errors.length == 0: Text {
                            text: "> no active BMS fault codes";
                            color: #5a5a5a;
                            font-size: 12px;
                            font-family: "DejaVu Sans Mono";
                        }
                        for msg in root.bms-errors: Text {
                            text: "> " + msg;
                            color: #ffb3b3;
                            font-size: 12px;
                            font-family: "DejaVu Sans Mono";
                        }
                    }
                }
            }
        }
    }
}

// ── temperature menu (key t): every temperature the backend reports ───────────
component TempMenu inherits Rectangle {
    in property <DashData> data;
    background: #0d0d0d;

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        Text {
            text: "TEMPERATURES";
            color: #d0d0d0;
            font-size: 15px;
            font-weight: 700;
        }

        Tile {
            height: 62px;
            label: "MOTOR"; unit: "°C";
            value: Fmt.n1(root.data.motor-temp);
            warn: root.data.motor-temp > 90; alarm: root.data.motor-temp > 110;
        }
        Tile {
            height: 62px;
            label: "CONTROLLER"; unit: "°C";
            value: Fmt.n1(root.data.mc-temp);
            warn: root.data.mc-temp > 70; alarm: root.data.mc-temp > 85;
        }
        Tile {
            height: 62px;
            label: "BMS"; unit: "°C";
            value: Fmt.n1(root.data.bms-temp);
            warn: root.data.bms-temp > 45; alarm: root.data.bms-temp > 55;
        }
        Tile {
            height: 62px;
            label: "HIGH CELL"; unit: "°C";
            value: Fmt.n1(root.data.high-cell-temp);
            warn: root.data.high-cell-temp > 45; alarm: root.data.high-cell-temp > 55;
        }
        Tile {
            height: 62px;
            label: "LOW CELL"; unit: "°C";
            value: Fmt.n1(root.data.low-cell-temp);
            warn: root.data.low-cell-temp < 0;
        }
    }
}

// ── powertrain menu (key p): pack + motor telemetry ──────────────────────────
component PowertrainMenu inherits Rectangle {
    in property <DashData> data;
    background: #0d0d0d;

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        Text {
            text: "POWERTRAIN";
            color: #d0d0d0;
            font-size: 15px;
            font-weight: 700;
        }

        HorizontalLayout {
            spacing: 12px;

            // pack / battery
            VerticalLayout {
                spacing: 8px;
                Text { text: "PACK"; color: #6a6a6a; font-size: 12px; font-weight: 700; }
                Tile {
                    height: 58px; label: "STATE OF CHARGE"; unit: "%";
                    value: Fmt.n1(root.data.soc);
                    warn: root.data.soc < 30; alarm: root.data.soc < 15;
                }
                Tile {
                    height: 58px; label: "PACK VOLTAGE"; unit: "V";
                    value: Fmt.n1(root.data.pack-voltage);
                }
                Tile {
                    height: 58px; label: "PACK CURRENT"; unit: "A";
                    value: Fmt.n1(root.data.pack-current);
                }
                Tile {
                    height: 58px; label: "AUX BATTERY"; unit: "V";
                    value: Fmt.n1(root.data.aux-voltage);
                    warn: root.data.aux-voltage < 12;
                }
                Tile {
                    height: 58px; label: "AUX BATTERY"; unit: "%";
                    value: Fmt.n0(root.data.aux-percent);
                }
            }

            // motor
            VerticalLayout {
                spacing: 8px;
                Text { text: "MOTOR"; color: #6a6a6a; font-size: 12px; font-weight: 700; }
                Tile {
                    height: 58px; label: "MOTOR RPM"; unit: "";
                    value: Fmt.n0(root.data.motor-rpm);
                }
                Tile {
                    height: 58px; label: "SPEED (motor)"; unit: "mph";
                    value: Fmt.n1(root.data.speed-mph);
                }
                Tile {
                    height: 58px; label: "THROTTLE"; unit: "%";
                    value: Fmt.n0(root.data.throttle);
                }
                Tile {
                    height: 58px; label: "MOTOR"; unit: "";
                    value: root.data.motor-on ? "ON" : "OFF";
                }
                Tile {
                    height: 58px; label: "BIKE STATUS"; unit: "";
                    value: root.data.status;
                }
            }
        }
    }
}

// ── gps menu (key g): raw gps readout + map placeholder ──────────────────────
// The map is not implemented — see the response notes for the offline-tile plan.
component GpsMenu inherits Rectangle {
    in property <DashData> data;
    background: #0d0d0d;

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        Text {
            text: "GPS";
            color: #d0d0d0;
            font-size: 15px;
            font-weight: 700;
        }

        HorizontalLayout {
            spacing: 12px;

            // raw readout
            Rectangle {
                width: 300px;
                background: #141414;
                border-radius: 6px;
                border-width: 1px;
                border-color: #262626;
                VerticalLayout {
                    padding: 12px;
                    spacing: 4px;
                    alignment: start;
                    Kv { k: "Position"; v: root.data.gps-pos; }
                    Kv { k: "Altitude"; v: "\{Fmt.n1(root.data.altitude-m)} m"; }
                    Kv { k: "Heading"; v: "\{root.data.heading}°"; }
                    Kv { k: "Speed"; v: "\{Fmt.n1(root.data.speed-gps)} mph"; }
                    Kv {
                        k: "Fix"; v: root.data.gps-fix ? "valid" : "none";
                        alarm: !root.data.gps-fix;
                    }
                    Kv { k: "Fix mode"; v: "\{root.data.gps-fix-mode}"; }
                    Kv { k: "GPS time"; v: "\{Fmt.n1(root.data.gps-time-s)} s"; }
                }
            }

            // map placeholder
            Rectangle {
                background: #0a0a0a;
                border-radius: 6px;
                border-width: 1px;
                border-color: #262626;

                // crosshair marking "you are here"
                Rectangle { width: 1px; height: 100%; background: #1e1e1e; }
                Rectangle { width: 100%; height: 1px; background: #1e1e1e; }
                Rectangle {
                    width: 12px; height: 12px;
                    border-radius: 6px;
                    background: root.data.gps-fix ? #35c759 : #5a5a5a;
                    border-width: 2px;
                    border-color: #0a0a0a;
                }

                VerticalLayout {
                    alignment: end;
                    padding: 10px;
                    spacing: 2px;
                    Text {
                        text: "MAP — offline tiles, not implemented";
                        color: #6a6a6a;
                        font-size: 11px;
                    }
                    Text {
                        text: root.data.gps-pos;
                        color: #8a8a8a;
                        font-size: 12px;
                        font-family: "DejaVu Sans Mono";
                    }
                }
            }
        }
    }
}

// ── hidden game menu (chord: all of d f t p g together) ──────────────────────
component GameMenu inherits Rectangle {
    background: #0d0d0d;

    VerticalLayout {
        alignment: center;
        spacing: 12px;
        Text {
            text: "🦖  DINO RUN";
            horizontal-alignment: center;
            color: white;
            font-size: 44px;
            font-weight: 800;
        }
        Text {
            text: "placeholder — game not implemented yet";
            horizontal-alignment: center;
            color: #7a7a7a;
            font-size: 14px;
        }
        Text {
            text: "press  d · f · t · p · g  to leave";
            horizontal-alignment: center;
            color: #5a5a5a;
            font-size: 12px;
        }
    }
}

export component MainWindow inherits Window {
    title: "Dirtbike Dash";
    preferred-width: 800px;
    preferred-height: 480px;
    background: #0d0d0d;
    default-font-family: "DejaVu Sans";

    // ── the two things Rust drives ──────────────────────────────────────────
    in property <DashData> data;
    in property <[string]> bms-errors;

    // ── FSM state ─────────────────────────────────────────────────────────
    property <Menu> menu: Menu.main;

    // chord detector for the hidden game menu: each menu key latches its own flag;
    // when all five are latched inside the timer window the game menu opens.
    // (Slint expressions have no bitwise ops, hence five bools rather than a mask.)
    property <bool> c-d;
    property <bool> c-f;
    property <bool> c-t;
    property <bool> c-p;
    property <bool> c-g;
    chord-timer := Timer {
        interval: 700ms;
        running: root.c-d || root.c-f || root.c-t || root.c-p || root.c-g;
        triggered() => {
            root.c-d = false;
            root.c-f = false;
            root.c-t = false;
            root.c-p = false;
            root.c-g = false;
        }
    }

    // toggle a menu: press its key to enter, press again to go back to main
    function go(target: Menu) {
        root.menu = root.menu == target ? Menu.main : target;
    }

    // ── UI → Rust ──────────────────────────────────────────────────────────
    callback shutdown();

    // keyboard: see the file header for the full key map
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == "q" { root.shutdown(); }
            if event.text == "d" { root.go(Menu.debug); root.c-d = true; }
            if event.text == "f" { root.go(Menu.fault); root.c-f = true; }
            if event.text == "t" { root.go(Menu.temp); root.c-t = true; }
            if event.text == "p" { root.go(Menu.powertrain); root.c-p = true; }
            if event.text == "g" { root.go(Menu.gps); root.c-g = true; }
            if root.c-d && root.c-f && root.c-t && root.c-p && root.c-g {
                root.menu = Menu.game;
                root.c-d = false;
                root.c-f = false;
                root.c-t = false;
                root.c-p = false;
                root.c-g = false;
            }
            accept
        }
    }

    if menu == Menu.main: MainMenu {
        width: 100%;
        height: 100%;
        data: root.data;
    }

    if menu == Menu.debug: DebugMenu {
        width: 100%;
        height: 100%;
        data: root.data;
        bms-errors: root.bms-errors;
    }

    if menu == Menu.fault: FaultMenu {
        width: 100%;
        height: 100%;
        data: root.data;
        bms-errors: root.bms-errors;
    }

    if menu == Menu.temp: TempMenu {
        width: 100%;
        height: 100%;
        data: root.data;
    }

    if menu == Menu.powertrain: PowertrainMenu {
        width: 100%;
        height: 100%;
        data: root.data;
    }

    if menu == Menu.gps: GpsMenu {
        width: 100%;
        height: 100%;
        data: root.data;
    }

    if menu == Menu.game: GameMenu {
        width: 100%;
        height: 100%;
    }
}
